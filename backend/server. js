
const express = require("express");

const app = express();

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    success: true,
    message: "Welcome to OnlineBazar API",
    status: "Backend setup in progress"
  });
});

app.get("/api/health", (req, res) => {
  res.json({
    success: true,
    service: "OnlineBazar Backend",
    status: "OK"
  });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, () => {
  console.log(`OnlineBazar API running on port ${PORT}`);
});
